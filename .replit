modules = ["python-3.11"]
run = "pip install -q -r requirements.txt && python src/flask_app.py"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["pip", "install", "-r", "requirements.txt"]
run = ["python", "src/flask_app.py"]

[[ports]]
localPort = 5000
externalPort = 80
